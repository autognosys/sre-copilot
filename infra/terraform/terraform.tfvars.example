# Copy this to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit it.

pve_api_endpoint = "https://65.108.102.155:8006/api2/json"

# Do NOT put the token secret here in practice — prefer:
#   export TF_VAR_pve_api_token='terraform@pve!provider=<secret>'
# Left here only to document the expected format.
# pve_api_token = "terraform@pve!provider=<secret>"

ssh_public_key_path = "~/.ssh/id_ed25519.pub"
